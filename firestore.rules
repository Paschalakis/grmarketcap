rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "q522FywUk8NMdkqOK5iTmGqoT553";
    }
    // κάθε χρήστης βλέπει και αλλάζει μόνο τα δικά του
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // ρυθμίσεις του site: τις διαβάζουν όλοι, τις αλλάζει μόνο ο ιδιοκτήτης.
    // τα στατιστικά (stats) και οι εντολές (cmd) είναι μόνο για τον ιδιοκτήτη.
    match /site/{doc} {
      allow read: if (doc != "stats" && doc != "cmd") || isOwner();
      allow write: if isOwner();
    }
  }
}
